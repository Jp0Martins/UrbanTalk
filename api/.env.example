# Copie para .env (o "npm run setup" faz isso e gera o JWT_SECRET automaticamente)

# porta da API (e do site, quando rodando com "npm start")
PORT=3000

# segredo das sessões: no mínimo 32 caracteres aleatórios. NUNCA versionar o valor real
JWT_SECRET=

# banco SQLite (arquivo criado automaticamente) e pasta das fotos
DATABASE_FILE=./data/urbantalk.sqlite
UPLOAD_DIR=./data/uploads

# tamanho máximo de cada foto, em MB
MAX_UPLOAD_MB=5

# true quando o site estiver atrás de HTTPS (cookie de sessão só trafega criptografado)
COOKIE_SECURE=false

# origens extras liberadas no CORS, separadas por vírgula. Vazio = só o próprio site
CORS_ORIGINS=

# servidores de tiles do mapa permitidos na política de segurança (mude se trocar de provedor)
MAP_TILE_HOSTS=https://*.tile.openstreetmap.org

# pasta do front-end compilado servida pela API em "npm start"
WEB_DIST=../web/dist/web/browser
